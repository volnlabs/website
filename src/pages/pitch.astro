---
import Base from '../layouts/Base.astro';

const pdf = '/pitch-deck.pdf';
---
<Base title="Actryn Pitch Deck" description="The non-confidential VolnLabs pitch deck for Actryn.">
  <main id="main-content" class="min pitch-wrap">
    <div class="pill quiet"><span class="dot"></span>Non-confidential · October 2026</div>
    <h1>Actryn<span class="accent">.</span></h1>
    <p class="lead">Controlled execution for AI-directed robots.</p>
    <div class="actions">
      <a href={pdf} target="_blank" rel="noopener">Open the deck</a>
    </div>
    <iframe class="deck" src={`${pdf}#view=FitH`} title="Actryn Pitch Deck"></iframe>
  </main>
</Base>
