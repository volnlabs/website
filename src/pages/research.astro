---
import Base from '../layouts/Base.astro';

const papers = [
  {
    status: 'Accepted · Poster',
    title: 'An Authority Lifecycle for Self-Modifying Embodied Agents',
    venue: 'AgenticOS Workshop @ NeurIPS 2026',
    abstract: 'Authority lifecycle for agents that modify and publish their own executable behavior at runtime. Separates proposal, activation, execution, resource and effect authority.',
  },
  {
    status: 'Accepted',
    title: 'Who Guards the Update? Transactional Publication Semantics for Continually Learning Embodied Agents',
    venue: 'CL4FMAgents Workshop @ NeurIPS 2026',
    abstract: 'Transactional publication semantics so stale or superseded behavior cannot keep control during updates. Part of AxiomOS’s runtime-evolution model.',
  },
];
---
<Base title="Research" description="VolnLabs research on admission, authority, publication and recovery for robots that take on new behavior while running.">
  <div class="min">
    <main id="main-content">
      <h1>Research<span class="accent">.</span></h1>
      <p class="lead">We study how robots can take on new behavior while keeping authority, publication and recovery explicit.</p>

      <h2 id="papers">Papers</h2>
      <div class="wide-stack">
        {papers.map((paper) => (
          <article class="paper">
            <div class="meta">
              <span class="status"><span class="dot"></span>{paper.status}</span>
              <span>2026</span>
            </div>
            <h3>{paper.title}</h3>
            <div class="meta">{paper.venue}</div>
            <p>{paper.abstract}</p>
          </article>
        ))}
      </div>

      <h2>Programs</h2>
      <div class="wide-stack">
        <section class="product-row">
          <div class="meta">Operating systems</div>
          <div class="stack">
            <h3>AxiomOS</h3>
            <p>Runtime-programmable kernel research covering admission, authority, transactional publication and recovery.</p>
            <p><a href="/axiomos">About AxiomOS</a></p>
          </div>
        </section>
        <section class="product-row">
          <div class="meta">Controlled execution</div>
          <div class="stack">
            <h3>Actryn</h3>
            <p>A product path that carries bounded operations through authorization, Linux enforcement and reconciliation.</p>
            <p><a href="/actryn">About Actryn</a></p>
          </div>
        </section>
      </div>

      <h2 id="people">People</h2>
      <p>Meet the people behind VolnLabs on the <a href="/about">About page</a>.</p>
    </main>
  </div>
</Base>
