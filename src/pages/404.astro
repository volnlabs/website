    <main style="padding-top:56px;">
      <a href="/" class="brand">
        <img src="/mark-light.png" alt="" style="height:18px;">
        <span>voln labs</span>
      </a>

      <h1 style="margin:12vh 0 40px;">404<span class="accent">.</span></h1>

      <p>This page doesn’t exist. The link may be broken, or the page may have moved.</p>

      <footer class="links" style="margin-top:120px;">
        <a href="/" class="quiet">Home</a><span>·</span>
        <a href="/research" class="quiet">Research</a><span>·</span>
        <a href="mailto:contact@volnlabs.com" class="quiet">Contact</a>
      </footer>
    </main>
  </div>
</Base>
