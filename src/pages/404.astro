---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you're looking for doesn't exist.">
  <div class="min">
    <main id="main-content" class="compact">
      <h1>404<span class="accent">.</span></h1>
      <p class="lead">This page doesn’t exist. The link may be broken, or the page may have moved.</p>
      <div class="actions">
        <a href="/">Return home</a>
        <a href="/contact" class="secondary">Contact VolnLabs</a>
      </div>
    </main>
  </div>
</Base>
